# Credentials are supplied by environment or JELEE_DATABASE_URL_FILE.
JELEE_DATABASE_URL=postgres://jelee:replace-this-password@127.0.0.1:5432/jelee?sslmode=verify-full
JELEE_LISTEN=127.0.0.1:8097
JELEE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
JELEE_MAX_CONNECTIONS=8
JELEE_MAX_STREAMS=8
# 可選記憶體部署設定：須同時載入 deploy/docker-compose.memory.yml。
# 以下是待量測的候選值，soft limit 不等於容器總記憶體保證；見 docs/runtime-memory.md。
# GOGC=100
# GOMEMLIMIT=512MiB
# JELEE_CONTAINER_MEMORY_LIMIT=768m
# 容器 memory+swap 上限沿用同一值，因此此設定不提供 swap。
# Opt in only after validating the corresponding staged API contracts.
JELEE_ENABLE_CATALOG=false
JELEE_ENABLE_DIRECT=false
JELEE_ENABLE_ACCOUNTS=false
JELEE_ENABLE_JOBS=false
# Probe requires jobs/accounts and the verified Linux amd64 production image.
JELEE_ENABLE_PROBE=false
# Jobs require accounts and at least workers + 2 PostgreSQL connections.
JELEE_JOB_WORKERS=2
JELEE_JOB_POLL_MILLISECONDS=250
JELEE_JOB_LEASE_SECONDS=30
JELEE_JOB_DATABASE_TIMEOUT_SECONDS=2
JELEE_JOB_MAX_RUNTIME_SECONDS=3600
JELEE_JOB_QUEUE_LIMIT=100
JELEE_JOB_HISTORY_LIMIT=20
JELEE_SCAN_MAX_ENTRIES=100000
JELEE_SCAN_MAX_DIRECTORIES=10000
JELEE_JOB_MAX_ATTEMPTS=3
JELEE_SCAN_MISSING_COUNT_LIMIT=100
JELEE_SCAN_MISSING_PERCENT_LIMIT=20
# Argon2id settings are bounded at startup; memory is per concurrent KDF.
JELEE_PASSWORD_MEMORY_KIB=65536
JELEE_PASSWORD_ITERATIONS=3
JELEE_PASSWORD_PARALLELISM=2
JELEE_PASSWORD_CONCURRENCY=2
# Login throttling uses the TCP peer IP and normalized account name.
JELEE_LOGIN_IP_LIMIT=60
JELEE_LOGIN_USER_LIMIT=10
JELEE_LOGIN_WINDOW_SECONDS=60
JELEE_LOGIN_MAX_ENTRIES=10000
JELEE_LOGIN_LOCK_AFTER=5
JELEE_LOGIN_LOCK_SECONDS=900
JELEE_MAX_SESSIONS=8
JELEE_SESSION_HOURS=24
JELEE_DEV_MODE=false

# Combined .jeleeignore and pinned .ignore semantics; requires jobs and a healthy helper.
JELEE_ENABLE_FAMILY_IGNORE=false

# Optional during metadata rollout. Setting either source enables startup validation.
# TMDB_API_KEY=your_v3_api_key
# TMDB_API_KEY_FILE=/run/secrets/tmdb_api_key

# Local Primary image thumbnails; requires accounts and catalog.
JELEE_ENABLE_IMAGES=false
# Existing private directory outside media roots; required when enabled.
# JELEE_IMAGE_TEMP_ROOT=/var/lib/jelee/image-work
JELEE_IMAGE_MAX_CONCURRENT=2
JELEE_IMAGE_MAX_WORKING_BYTES=100663296
JELEE_IMAGE_MAX_SOURCE_BYTES=16777216
JELEE_IMAGE_MAX_OUTPUT_BYTES=2097152
JELEE_IMAGE_MAX_OUTPUT_DIMENSION=1024
JELEE_IMAGE_CACHE_BYTES=33554432
JELEE_IMAGE_CACHE_ENTRIES=128
JELEE_IMAGE_CACHE_TTL_SECONDS=300
JELEE_IMAGE_TIMEOUT_SECONDS=15
JELEE_IMAGE_DEFAULT_QUALITY=85
# Optional persistent original/variant store; not yet used by image requests.
# Existing private directory outside media roots and the scratch directory.
# JELEE_IMAGE_STORE_ROOT=/var/lib/jelee/image-store
JELEE_IMAGE_STORE_ORIGINAL_BYTES=4294967296
JELEE_IMAGE_STORE_VARIANT_BYTES=1073741824
JELEE_IMAGE_STORE_ENTRIES=131072
