# Credentials are supplied by environment or JELEE_DATABASE_URL_FILE.
JELEE_DATABASE_URL=postgres://jelee:replace-this-password@127.0.0.1:5432/jelee?sslmode=verify-full
JELEE_LISTEN=127.0.0.1:8097
JELEE_ALLOWED_HOSTS=localhost,127.0.0.1,::1
JELEE_MAX_CONNECTIONS=8
JELEE_MAX_STREAMS=8
# Opt in only after validating the corresponding staged API contracts.
JELEE_ENABLE_CATALOG=false
JELEE_ENABLE_DIRECT=false
JELEE_ENABLE_ACCOUNTS=false
# Argon2id settings are bounded at startup; memory is per concurrent KDF.
JELEE_PASSWORD_MEMORY_KIB=65536
JELEE_PASSWORD_ITERATIONS=3
JELEE_PASSWORD_PARALLELISM=2
JELEE_PASSWORD_CONCURRENCY=2
# Login throttling uses the TCP peer IP and normalized account name.
JELEE_LOGIN_IP_LIMIT=60
JELEE_LOGIN_USER_LIMIT=10
JELEE_LOGIN_WINDOW_SECONDS=60
JELEE_LOGIN_MAX_ENTRIES=10000
JELEE_LOGIN_LOCK_AFTER=5
JELEE_LOGIN_LOCK_SECONDS=900
JELEE_MAX_SESSIONS=8
JELEE_SESSION_HOURS=24
JELEE_DEV_MODE=false
