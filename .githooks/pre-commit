#!/bin/sh
# Jelee pre-commit hook (G01.6): fast checks on what is about to be committed.
# Install with `make hooks` (or `pwsh -File scripts/make.ps1 hooks`), which sets
# core.hooksPath=.githooks for this clone only. CI runs the same gates, so
# `git commit --no-verify` only moves the failure to CI.
set -u
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

go_files=$(printf '%s\n' "$staged" | grep '\.go$' || true)
if [ -n "$go_files" ]; then
	# shellcheck disable=SC2086 # Go file names in this repository have no spaces.
	unformatted=$(run_go run cmd/gofmt -l $go_files) || failed=1
	if [ -n "$unformatted" ]; then
		echo "jelee hooks: gofmt needed (make fmt):" >&2
		printf '%s\n' "$unformatted" >&2
		failed=1
	fi
fi

step "text encoding (LF, UTF-8 without BOM)" run_go run ./tools/textcheck -staged
step "secret scan" run_go run ./tools/secretscan -staged
step "gitignore check" run_go run ./tools/gitignore-check
step "brand scan" run_go run ./tools/brand-scan --new

if printf '%s\n' "$staged" | grep -q '^web/'; then
	if [ -d node_modules ] && [ -x .bin/npm ]; then
		step "web lint" .bin/npm --workspace @jelee/web run --silent lint
	else
		echo "jelee hooks: web/ changed but the web toolchain is not installed; run make web-install to lint locally (CI runs web-lint on Linux)" >&2
	fi
fi

exit "$failed"
