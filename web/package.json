{
  "name": "@jelee/web",
  "version": "0.1.0",
  "private": true,
  "description": "Jelee web frontend: browsing and administration only, never media playback",
  "license": "GPL-2.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-no-playback.mjs --require-dist && node scripts/check-bundle-budget.mjs",
    "budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "api:generate": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "types": "node scripts/api-types.mjs --check && vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check:no-playback": "node scripts/check-no-playback.mjs",
    "lint": "eslint --max-warnings=0 . && node scripts/check-i18n.mjs && node scripts/check-no-playback.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  }
}
